# ──────────────────────────────────────────────
#  SSPR Backend – Variables de Entorno
#  Copia este archivo como .env y completa los valores
# ──────────────────────────────────────────────

# Puerto local (Render lo ignora y usa el suyo propio)
PORT=3000

# Clave secreta para firmar los JWT  ← CAMBIA ESTO en producción
JWT_SECRET=sspr_clave_super_secreta_cambiar_en_produccion

# Duración del token (ej: 1h, 2h, 7d)
JWT_EXPIRES_IN=2h

# Origen permitido para CORS (URL del frontend en producción)
FRONTEND_URL=http://localhost:5173
